{
  "name": "badseo",
  "private": true,
  "type": "module",
  "description": "badseo.dev — a deliberately broken website full of SEO mistakes, used as e2e test fixtures for the OpenSEO site audit.",
  "scripts": {
    "dev": "vite dev",
    "start": "vite dev",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "audit": "cd .. && tsx badseo/scripts/run-audit.ts",
    "test:e2e": "cd .. && tsx badseo/scripts/run-audit.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-start": "^1.168.56",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.135.0"
  }
}
