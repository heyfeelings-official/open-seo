{
  "name": "open-seo-landing",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/generate-sitemap.js",
    "build:app": "vite build",
    "sitemap": "node scripts/generate-sitemap.js",
    "start": "wrangler dev",
    "preview": "vite preview",
    "types:check": "fumadocs-mdx && tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "deploy": "VITE_REQUIRE_TURNSTILE=1 npm run build && wrangler deploy",
    "deploy:prod": "VITE_REQUIRE_TURNSTILE=1 npm run build && wrangler deploy",
    "deploy:preview": "CLOUDFLARE_ENV=preview VITE_REQUIRE_TURNSTILE=1 npm run build && wrangler deploy",
    "test:protection": "vitest run && node scripts/check-free-tool-budget.cjs"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.23",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.168.56",
    "fumadocs-core": "^16.15.12",
    "fumadocs-mdx": "^15.4.2",
    "fumadocs-ui": "^16.15.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@cloudflare/workers-types": "5.20260920.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.8",
    "srvx": "^1.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "5.0.1",
    "wrangler": "^4.135.0"
  }
}
